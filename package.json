{
  "name": "cookin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler pages dev dist",
    "build": "tsc -b && vite build",
    "build:bookmarklet": "node tools/bookmarklet/build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply cookin --local",
    "db:migrate:remote": "wrangler d1 migrations apply cookin --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name cookin",
    "lint": "eslint .",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@cloudflare/workers-types": "^5.20261101.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
